@attribute [UCFTemplate("Start Page")]
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<StartPageViewModel>

@{
	Layout = null;
}

<h1>@Model.Content.MainHeading</h1>

<ol>
    @foreach (var blogPost in Model.BlogPosts)
    {
        <li>
            <h2>@blogPost.MainHeading</h2>
            @foreach (var content in blogPost.MainContent!) {
                @*
                @await Component.InvokeAsync(ElementHelper.GetViewComponentForElement(content.Content), new { content.Content })*@
                @await ElementHelper.RenderViewComponentForElementAsync(content.Content)
            }
        </li>
    }
</ol>
