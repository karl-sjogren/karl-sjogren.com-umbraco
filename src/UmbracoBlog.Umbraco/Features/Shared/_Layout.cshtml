@inject Shorthand.Vite.Contracts.IViteService Vite
@inherits UmbracoViewPage<LayoutViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <meta name="format-detection" content="telephone=no">

        @if(Model.BlockSearchEngineIndexing) {
            <meta name="robots" content="noindex, nofollow" />
        }

        <title>@Model.Title</title>
        @if(!string.IsNullOrWhiteSpace(Model.MetaDescription)) {
            <meta name="description" content="@Model.MetaDescription" />
        }

        <environment exclude="Development">
            <link rel="modulepreload" href="@await Vite.GetAssetUrlAsync("scripts/index.mjs")" as="script" />
            <link rel="preload" href="@await Vite.GetAssetUrlAsync("assets/fonts/font.woff2")" as="font" type="font/woff2" crossorigin>
            <link rel="preload" href="@await Vite.GetAssetUrlAsync("assets/fonts/font2.woff2")" as="font" type="font/woff2" crossorigin>
            <link rel="stylesheet" href="@await Vite.GetAssetUrlAsync("style.css")" />
        </environment>

        @RenderSection("Header", required: false)
    </head>

    <body>
        <aside aria-label="Sidebar">
            <header class="profile-wrapper">
                <a href="/" class="avatar-link">
                    <img src="/static/images/avatar_cropped.png" width="112" height="112">
                </a>
                <h1 class="site-title"><a href="/">@Model.SiteSettings?.SiteName</a></h1>
                <p class="site-tagline">@Model.SiteSettings?.SiteTagline</p>
            </header>

            <vc:Navigation />

            <footer>
                @{
                    var siteSettings = Model.SiteSettings;

                    if(!string.IsNullOrWhiteSpace(siteSettings?.GithubLink)) {
                        <a href="@siteSettings.GithubLink" aria-label="My Github profile" target="_blank" rel="noopener noreferrer"> <i class="fa-brands fa-github"></i> </a>
                    }

                    if(!string.IsNullOrWhiteSpace(siteSettings?.StackoverflowLink)) {
                        <a href="@siteSettings.StackoverflowLink" aria-label="My Stack Overflow profile" target="_blank" rel="noopener noreferrer"> <i class="fa-brands fa-stack-overflow"></i> </a>
                    }

                    if(!string.IsNullOrWhiteSpace(siteSettings?.Email)) {
                        var email = siteSettings.Email;
                        var splitEmail = email.Split('@');
                        if(splitEmail.Length == 2) {
                            var href = "javascript:location.href = 'mailto:' + ['" + splitEmail[0] + "','" + splitEmail[1] + "'].join('@');";
                            <a href="@href" aria-label="My Email" target="_blank" rel="noopener noreferrer"> <i class="fa-solid fa-envelope"></i> </a>
                        }
                    }
                }
            </footer>
        </aside>

        <main>
            @RenderBody()
        </main>

        <script src="@await Vite.GetAssetUrlAsync("scripts/index.mjs")" type="module"></script>

        <environment names="Development">
            <script src="/_framework/aspnetcore-browser-refresh.js"></script>
        </environment>
    </body>
</html>
