@attribute [UCFTemplate("Content Page")]
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<LayoutViewModel<UmbracoBlog.Core.Documents.ContentPage>>

<article class="content-page">
    <h2>@Model.ViewModel.MainHeading</h2>

    @foreach (var content in Model.ViewModel.MainContent!) {
        @await ElementHelper.RenderViewComponentForElementAsync(content.Content)
    }
</article>
