@attribute [UCFTemplate("Blog Post")]
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<LayoutViewModel<UmbracoBlog.Core.Documents.BlogPost>>

<article class="blog-post">
    <header>
        <h2>@Model.ViewModel.MainHeading</h2>
        <div class="blog-post-meta">
            <span class="published"> <i class="fa fa-calendar"></i> <time datetime="@Model.ViewModel.PublishDate.ToString("yyyy-MM-dd")">@Model.ViewModel.PublishDate.ToString("MMMM dd, yyyy")</time> </span>

            @if(Model.ViewModel.Tags?.Any() == true) {
                <div class="tags">
                    <i class="fas fa-tags"></i>
                    <ul class="tag-list">
                        @foreach (var tag in Model.ViewModel.Tags!) {
                            <li>@tag</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </header>

    @foreach (var content in Model.ViewModel.MainContent!) {
        @await ElementHelper.RenderViewComponentForElementAsync(content.Content)
    }
</article>

@section RightPanel {
    <section class="table-of-contents" aria-labelledby="table-of-contents-heading">
        <span id="table-of-contents-heading">Table of contents</span>
    </section>

    <section class="share-buttons">
        <a class="web-share" title="Share this post" href="#"><i class="fas fa-arrow-up-from-bracket"></i></a>
        <a class="copy-link" data-clipboard-text="@Model.CanonicalUrl" title="Copy link" href="#"><i class="fas fa-link"></i></a>

        @{
            string encodedTitle = Model.ViewModel.MainHeading is not null ? Html.UrlEncoder.Encode(Model.ViewModel.MainHeading) : string.Empty;
            string encodedUrl = Model.CanonicalUrl is not null ? Html.UrlEncoder.Encode(Model.CanonicalUrl) : string.Empty;
        }

        @if(!string.IsNullOrEmpty(encodedTitle) && !string.IsNullOrEmpty(encodedUrl)) {
            <a class="twitter-share" title="Share on Twitter" target="_blank" rel="noopener noreferrer" href="https://x.com/intent/tweet?text=@encodedTitle&url=@encodedUrl"><i class="fab fa-twitter"></i></a>
            <a class="facebook-share" title="Share on Facebook" target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"><i class="fab fa-facebook"></i></a>
            <a class="linkedin-share" title="Share on LinkedIn" target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/shareArticle?mini=true&url=@encodedUrl&title=@encodedTitle"><i class="fab fa-linkedin"></i></a>
        }
    </section>
}
