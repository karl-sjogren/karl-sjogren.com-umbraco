<Project>
  <ItemGroup Condition="'$(DisableShorthandUmbracoHelpersBannedSymbols)' != 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Shorthand.UmbracoHelpers.txt"
      Condition="'@(AdditionalFiles->WithMetadataValue('Filename', 'BannedSymbols.Shorthand.UmbracoHelpers'))' == ''" />
  </ItemGroup>

  <!-- Track opt-out changes as a compiler input so incremental builds re-run analysis. -->
  <Target Name="_TrackShorthandUmbracoHelpersBannedSymbols" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ShorthandUmbracoHelpersBannedSymbolsCache>$(IntermediateOutputPath)Shorthand.UmbracoHelpers.BannedSymbols.cache</_ShorthandUmbracoHelpersBannedSymbolsCache>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_ShorthandUmbracoHelpersBannedSymbolsCache)"
                      Lines="Disabled=$(DisableShorthandUmbracoHelpersBannedSymbols)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(_ShorthandUmbracoHelpersBannedSymbolsCache)" />
      <FileWrites Include="$(_ShorthandUmbracoHelpersBannedSymbolsCache)" />
    </ItemGroup>
  </Target>
</Project>
